# Repository-wide rules. Keep Python source, pyproject.toml, uv.lock, schemas,
# catalog content, documentation, safe configuration examples, and selected images.

# Python environments and interpreter/tool caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.uv-cache/
**/.cache/uv/

# Test, coverage, packaging, and generated documentation outputs
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
junit.xml
nosetests.xml
build/
dist/
site/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.manifest
*.spec

# Environment secrets; retain deliberately sanitized examples and templates
.env
.env.*
*.env
*.env.*
!.env.example
!.env.sample
!.env.template
!*.env.example
!*.env.sample
!*.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc
.direnv/

# Local AWS state, credentials, session material, and private key files
.aws/
aws-exports.js
aws-credentials
aws-credentials.*
aws_credentials
aws_credentials.*
credentials
credentials.json
credentials.csv
credentials.local.*
session-token
session-token.*
session_token
session_token.*
aws-session-token*
aws_session_token*
token.json
tokens.json
*.pem
*.key
*.p12
*.pfx
!aws-credentials.example
!aws_credentials.example
!credentials.example
!credentials.*.example
!session-token.example
!session_token.example
!*.key.example
!*.pem.example

# Account-specific AgentCore toolkit configuration and generated runtime artifacts
.bedrock_agentcore.yaml
.bedrock_agentcore.yml
.bedrock_agentcore.*.yaml
.bedrock_agentcore.*.yml
.bedrock_agentcore.yaml.*
.bedrock_agentcore.yml.*
.bedrock_agentcore/
.agentcore/
agentcore_deploy*.zip
deployment.zip
dependencies.zip
dependencies.hash
!.bedrock_agentcore.example.yaml
!.bedrock_agentcore.example.yml
!.bedrock_agentcore.yaml.example
!.bedrock_agentcore.yml.example

# Raw local responses and logs may contain prompts, identities, or tool payloads.
# Curated, sanitized evidence and screenshots should use explicit descriptive names.
refund_test.json
*.log
*.log.*
logs/
.logs/
*.pid
*.pid.lock
*.out
*.err
crash.log
crash.*.log

# Temporary files, backups, and editor-local state
tmp/
temp/
.tmp/
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.code-workspace
.history/
.ropeproject/

# macOS metadata (already tracked files require a separate index cleanup)
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Avoid broad *.json, *.yaml, *.txt, *.png, *.jpg, or *.zip rules:
# required schemas, non-sensitive examples, and approved evidence must remain addable.
